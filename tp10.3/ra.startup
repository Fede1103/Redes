ip a add 170.16.255.252/17 dev eth0
ip link set dev eth0 mtu 1200
ip link set dev eth0 up

ip a add 192.168.50.129/30 dev eth1
ip link set dev eth1 mtu 1000
ip link set dev eth1 up

ip a add 192.168.50.142/30 dev eth2
ip link set dev eth2 mtu 1500
ip link set dev eth2 up

ip route add 129.30.192.64/26 via 192.168.50.130 dev eth1
ip route add 200.3.124.0/26 via 192.168.50.141 dev eth2
ip route add 11.11.0.0/20 via 192.168.50.141 dev eth2

ip route add default via 192.168.50.141 dev eth2 

cat /shared/hosts.txt >> /etc/hosts
