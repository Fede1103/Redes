ip a add 129.30.192.124/26 dev eth0
ip link set dev eth0 mtu 1000
ip link set dev eth0 up

ip a add 192.168.50.150/30 dev eth1
ip link set dev eth1 mtu 1500
ip link set dev eth1 up

ip a add 192.168.50.146/30 dev eth2
ip link set dev eth2 mtu 620
ip link set dev eth2 up

ip route add 170.16.128.0/17 via 192.168.50.145 dev eth2
ip route add 11.11.0.0/20 via 192.168.50.149 dev eth1
ip route add 200.3.124.0/26 via 192.168.50.145 dev eth2

ip route add default via 192.168.50.145 dev eth2

cat /shared/hosts.txt >> /etc/hosts
