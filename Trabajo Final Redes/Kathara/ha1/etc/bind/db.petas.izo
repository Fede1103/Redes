$TTL    604800
@       IN      SOA     ha1.petas.izo. root.petas.izo. (
                        2026111601  ; Serial
                        604800      ; Refresh
                        86400       ; Retry
                        2419200     ; Expire
                        604800 )    ; Negative Cache TTL
