ulimit -n 1024

# eth0 - LL (172.16.3.0/24) - 254@0
ip a add 172.16.3.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EI_L hacia RI (192.168.200.36/30) - 38@1
ip a add 192.168.200.38/30 dev eth1
ip link set dev eth1 up

# eth2 - EL_Q hacia RQ (192.168.200.52/30) - 53@2
ip a add 192.168.200.53/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
