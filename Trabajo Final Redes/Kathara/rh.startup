ulimit -n 1024

# eth0 - LH (192.168.10.0/25) - 126@0
ip a add 192.168.10.126/25 dev eth0
ip link set dev eth0 up

# eth1 - EDE_H hacia RDE (192.168.200.20/30) - 22@1
ip a add 192.168.200.22/30 dev eth1
ip link set dev eth1 up

# eth2 - EH_I hacia RI (192.168.200.32/30) - 33@2
ip a add 192.168.200.33/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
