ulimit -n 1024

# eth0 - LD (10.3.0.0/19) - 31.254@0
ip a add 10.3.31.254/19 dev eth0
ip link set dev eth0 up

# eth1 - LE (10.4.0.0/21) - 7.254@1
ip a add 10.4.7.254/21 dev eth1
ip link set dev eth1 up

# eth2 - EA_DE hacia RA (192.168.200.4/30) - 6@2
ip a add 192.168.200.6/30 dev eth2
ip link set dev eth2 up

# eth3 - EDE_H hacia RH (192.168.200.20/30) - 21@3
ip a add 192.168.200.21/30 dev eth3
ip link set dev eth3 up

# eth4 - EDE_K hacia RK (192.168.200.24/30) - 25@4
ip a add 192.168.200.25/30 dev eth4
ip link set dev eth4 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
