ulimit -n 1024

# eth0 - LT (192.168.80.0/24) - 254@0
ip a add 192.168.80.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EO_T hacia RO (192.168.200.64/30) - 66@1
ip a add 192.168.200.66/30 dev eth1
ip link set dev eth1 up

# eth2 - ES_T hacia RS (192.168.200.72/30) - 74@2
ip a add 192.168.200.74/30 dev eth2
ip link set dev eth2 up

# eth3 - ET_U hacia RU (192.168.200.80/30) - 81@3
ip a add 192.168.200.81/30 dev eth3
ip link set dev eth3 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
