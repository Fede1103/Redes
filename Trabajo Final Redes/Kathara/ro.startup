ulimit -n 1024

# eth0 - LO (172.16.6.0/24) - 254@0
ip a add 172.16.6.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EK_O hacia RK (192.168.200.48/30) - 50@1
ip a add 192.168.200.50/30 dev eth1
ip link set dev eth1 up

# eth2 - EO_P hacia RP (192.168.200.60/30) - 61@2
ip a add 192.168.200.61/30 dev eth2
ip link set dev eth2 up

# eth3 - EO_T hacia RT (192.168.200.64/30) - 65@3
ip a add 192.168.200.65/30 dev eth3
ip link set dev eth3 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
