ulimit -n 1024

# eth0 - LP (172.16.7.0/24) - 254@0
ip a add 172.16.7.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EO_P hacia RO (192.168.200.60/30) - 62@1
ip a add 192.168.200.62/30 dev eth1
ip link set dev eth1 up

# eth2 - EP_Q hacia RQ (192.168.200.68/30) - 69@2
ip a add 192.168.200.69/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
