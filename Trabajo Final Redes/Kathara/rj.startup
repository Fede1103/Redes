ulimit -n 1024

# eth0 - LJ (192.168.30.0/30) - 2@0
ip a add 192.168.30.2/30 dev eth0
ip link set dev eth0 up

# eth1 - EG_J hacia RG (192.168.200.28/30) - 30@1
ip a add 192.168.200.30/30 dev eth1
ip link set dev eth1 up

# eth2 - EJ_M hacia RM (192.168.200.40/30) - 41@2
ip a add 192.168.200.41/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
