ulimit -n 1024

# eth0 - LG (172.16.2.0/24) - 254@0
ip a add 172.16.2.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EBC_G hacia RBC (192.168.200.12/30) - 14@1
ip a add 192.168.200.14/30 dev eth1
ip link set dev eth1 up

# eth2 - EG_J hacia RJ (192.168.200.28/30) - 29@2
ip a add 192.168.200.29/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
