ulimit -n 1024

# eth0 - LS (192.168.70.0/24) - 254@0
ip a add 192.168.70.254/24 dev eth0
ip link set dev eth0 up

# eth1 - ES_T hacia RT (192.168.200.72/30) - 73@1
ip a add 192.168.200.73/30 dev eth1
ip link set dev eth1 up

# eth2 - ES_V hacia RV (192.168.200.76/30) - 77@2
ip a add 192.168.200.77/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
