ulimit -n 1024

# eth0 - LV (192.168.110.0/24) - 254@0
ip a add 192.168.110.254/24 dev eth0
ip link set dev eth0 up

# eth1 - ES_V hacia RS (192.168.200.76/30) - 78@1
ip a add 192.168.200.78/30 dev eth1
ip link set dev eth1 up

# eth2 - EU_V hacia RU (192.168.200.84/30) - 86@2
ip a add 192.168.200.86/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
