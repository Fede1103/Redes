ulimit -n 1024

# eth0 - LM (172.16.4.0/24) - 254@0
ip a add 172.16.4.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EJ_M hacia RJ (192.168.200.40/30) - 42@1
ip a add 192.168.200.42/30 dev eth1
ip link set dev eth1 up

# eth2 - EM_R hacia RR (192.168.200.56/30) - 57@2
ip a add 192.168.200.57/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
