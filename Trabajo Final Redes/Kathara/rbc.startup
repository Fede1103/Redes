ulimit -n 1024

# eth0 - LB (10.0.0.0/15) - 1.255.254@0
ip a add 10.1.255.254/15 dev eth0
ip link set dev eth0 up

# eth1 - LC (10.2.0.0/18) - 63.254@1
ip a add 10.2.63.254/18 dev eth1
ip link set dev eth1 up

# eth2 - EA_BC hacia RA (192.168.200.0/30) - 2@2
ip a add 192.168.200.2/30 dev eth2
ip link set dev eth2 up

# eth3 - EBC_F hacia RF (192.168.200.8/30) - 9@3
ip a add 192.168.200.9/30 dev eth3
ip link set dev eth3 up

# eth4 - EBC_G hacia RG (192.168.200.12/30) - 13@4
ip a add 192.168.200.13/30 dev eth4
ip link set dev eth4 up

# eth5 - EBC_K hacia RK (192.168.200.16/30) - 17@5
ip a add 192.168.200.17/30 dev eth5
ip link set dev eth5 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
