ulimit -n 1024

# eth0 - LA (192.168.100.0/29) - 6@0
ip a add 192.168.100.6/29 dev eth0
ip link set dev eth0 up

# eth1 - EA_BC hacia RBC (192.168.200.0/30) - 1@1
ip a add 192.168.200.1/30 dev eth1
ip link set dev eth1 up

# eth2 - EA_DE hacia RDE (192.168.200.4/30) - 5@2
ip a add 192.168.200.5/30 dev eth2
ip link set dev eth2 up

# eth3 (bridged)
# NAT de salida para toda la red interna
iptables -t nat -A POSTROUTING -o eth3 -j MASQUERADE
# Publicacion del servidor web
iptables -t nat -A PREROUTING -i eth3 -p tcp --dport 80 -j DNAT --to-destination 192.168.100.2:80

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
