ulimit -n 1024

# eth0 - LQ (192.168.50.0/24) - 254@0
ip a add 192.168.50.254/24 dev eth0
ip link set dev eth0 up

# eth1 - EL_Q hacia RL (192.168.200.52/30) - 54@1
ip a add 192.168.200.54/30 dev eth1
ip link set dev eth1 up

# eth2 - EP_Q hacia RP (192.168.200.68/30) - 70@2
ip a add 192.168.200.70/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
