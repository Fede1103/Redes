ulimit -n 1024

# eth0 - LI (192.168.20.0/29) - 6@0
ip a add 192.168.20.6/29 dev eth0
ip link set dev eth0 up

# eth1 - EH_I hacia RH (192.168.200.32/30) - 34@1
ip a add 192.168.200.34/30 dev eth1
ip link set dev eth1 up

# eth2 - EI_L hacia RL (192.168.200.36/30) - 37@2
ip a add 192.168.200.37/30 dev eth2
ip link set dev eth2 up

cp /shared/resolv.conf /etc/resolv.conf

/etc/init.d/quagga start
